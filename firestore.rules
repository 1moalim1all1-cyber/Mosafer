rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userGender() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gender;
    }

    function isActiveAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.referralCode == resource.data.referralCode
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ---- Drivers ----
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Trips ----
    match /trips/{tripId} {
      allow read: if resource.data.isWomenOnly == false ||
        (isSignedIn() && (userGender() == 'female' || isAdmin()));

      allow create: if isSignedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        isActiveAccount() &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.verificationStatus == 'approved';

      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.driverId == request.auth.uid) ||
        (isSignedIn() && changedKeys().hasOnly(['availableSeats', 'status']));

      allow delete: if isOwner(resource.data.driverId) || isAdmin();

      match /locationHistory/{pointId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid;
      }
    }

    // ---- Bookings ----
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid && isActiveAccount();
      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // ---- Wallets ----
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.balance is number &&
        request.resource.data.balance >= 0 &&
        request.resource.data.balance <= 200;
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if false;

      match /walletTransactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---- Config Collections ----
    match /governorates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carTypes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        changedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }
    match /pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- Chats ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.passengerId == request.auth.uid ||
         request.resource.data.driverId == request.auth.uid);
      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.passengerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid ||
           isAdmin());
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.passengerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    match /tripRequests/{requestId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid && isActiveAccount();
      allow update: if isOwner(resource.data.passengerId) || isAdmin();
      allow delete: if isOwner(resource.data.passengerId) || isAdmin();
    }

    match /tripOffers/{offerId} {
      allow read: if isSignedIn() && (isOwner(resource.data.passengerId) || isOwner(resource.data.driverId));
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid && isActiveAccount();
      allow update: if isSignedIn() && isOwner(resource.data.passengerId);
    }

    match /tripAlerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
  }
}
