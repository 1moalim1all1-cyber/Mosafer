rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userGender() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gender;
    }

    // حساب موقوف أو محظور من الإدارة مايقدرش يحجز أو ينشر رحلات جديدة
    function isActiveAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ---- Drivers ----
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Trips ----
    match /trips/{tripId} {
      // القراءة متاحة للجميع (حتى زائر مش مسجّل دخول) للرحلات العادية،
      // عشان تظهر في صفحة الهبوط - رحلات السيدات فقط لازم تسجيل دخول
      // وتحقق من الجنس، حفاظًا على الخصوصية
      allow read: if resource.data.isWomenOnly == false ||
        (isSignedIn() && (userGender() == 'female' || isAdmin()));

      allow create: if isSignedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        isActiveAccount() &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.verificationStatus == 'approved';

      allow update: if isSignedIn();
      allow delete: if isOwner(resource.data.driverId) || isAdmin();

      // مسار الرحلة الكامل (سجل GPS) - أي مستخدم مسجّل دخول يقدر يكتب
      // نقطة (السائق وقت المشاركة)، والقراءة مفتوحة لمين مسجّل دخول
      // بس (مش عامة زي الرحلة نفسها، لأنه بيانات موقع أدق وأحسّاسية)
      match /locationHistory/{pointId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }
    }

    // ---- Bookings ----
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid && isActiveAccount();
      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // ---- Wallets ----
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.balance == 0;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      match /walletTransactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---- Config Collections ----
    match /governorates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carTypes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- Chats ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.passengerId == request.auth.uid ||
         request.resource.data.driverId == request.auth.uid);
      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.passengerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid ||
           isAdmin());
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    // ---- Ratings ----
    match /ratings/{ratingId} {
      // قراءة عامة (حتى لزائر مش مسجّل دخول) عشان تبان في قسم "آراء
      // المستخدمين" بصفحة الهبوط - نفس منطق الرحلات العادية بالظبط
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Reports ----
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
  }
}
