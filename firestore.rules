rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userGender() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gender;
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // المستخدم يقدر يعدّل بياناته الشخصية الآمنة بس (اسم، صورة، لغة،
      // مفضلة...) - مش role ولا trustScore ولا avgRating ولا totalTrips
      // ولا gender (لأن الجنس أساس حماية رحلات السيدات، تغييره الحر
      // ممكن يُستخدم لالتفاف على الحماية دي). أي تعديل على الحقول
      // الحساسة دي محصور على الإدارة أو Cloud Functions فقط.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'profileImageUrl', 'language',
            'favoriteTrips', 'fcmTokens', 'isPhoneVerified', 'isEmailVerified'
          ]));
      allow delete: if isAdmin();

      // إشعارات المستخدم - الإنشاء الفعلي بقى حصريًا عبر Cloud Functions
      // (Admin SDK بيتجاوز القواعد دي تلقائيًا)، فالعميل بقى يقدر بس
      // يقرا إشعاراته ويعلّمها كمقروءة، مش يبتدع إشعارات مباشرة زي Phase 6.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---- Drivers (مستندات حساسة - القراءة للمالك والإدارة فقط) ----
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if isOwner(driverId);
      // السائق يقدر يعيد رفع مستنداته (الحالة الجديدة "pending" بس)،
      // أي تغيير لحالة "approved" لازم يمر عبر الإدارة حصرًا.
      allow update: if isAdmin() ||
        (isOwner(driverId) &&
          request.resource.data.verificationStatus == 'pending' &&
          resource.data.verificationStatus != 'approved');
      allow delete: if isAdmin();
    }

    // ---- Trips ----
    // القاعدة الحرجة: رحلات "سيدات فقط" ما تُقرأش إلا لو المستخدم أنثى أو أدمن.
    // ده بيمنع تسريب البيانات حتى لو حصل تلاعب في فلتر الواجهة.
    match /trips/{tripId} {
      allow read: if isSignedIn() &&
        (resource.data.isWomenOnly == false || userGender() == 'female' || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.verificationStatus == 'approved';

      // السائق (صاحب الرحلة) يقدر يعدّل/يلغي رحلته بالكامل من التطبيق.
      // ملحوظة: التعديل المؤقت اللي كان مضطر يسمح لأي مستخدم مسجّل دخول
      // يغيّر availableSeats/status (Phase 4) اتشال نهائيًا دلوقتي - الحجز
      // والإلغاء وقفل الرحلة بقوا حصريًا عبر Cloud Functions (createBooking,
      // respondToBooking, markTripCompleted) اللي بتشتغل بصلاحيات Admin SDK
      // وبتتجاوز القواعد دي أصلًا، فمفيش داعي نفتح ثغرة للعميل خالص.
      allow update: if isOwner(resource.data.driverId) || isAdmin();
      allow delete: if isOwner(resource.data.driverId) || isAdmin();
    }

    // ---- Bookings ----
    // الإنشاء والتحديث بقوا حصريًا عبر Cloud Functions (createBooking,
    // respondToBooking) - العميل يقدر يقرا حجوزاته بس، مفيش أي كتابة مباشرة
    // مسموحة من التطبيق تاني، وده بيقفل ثغرة "لعب في المقاعد" نهائيًا.
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Wallets ----
    // الرصيد نفسه (balance) بقى Read-Only بالكامل من العميل - أي حركة
    // فعلية (دفع/استرداد/عمولة) بتتم حصريًا عبر Cloud Functions بصلاحيات
    // Admin SDK. المسموح للعميل هو بس تسجيل *طلب* إيداع/سحب معلّق
    // (status: 'pending') اللي مبيغيّرش الرصيد نفسه أبدًا.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // إنشاء المحفظة الأولى بيحصل وقت التسجيل (رصيد صفر بس) - أي حاجة
      // بعد كده (تعديل الرصيد) بقت حصرية على Cloud Functions.
      allow create: if isOwner(userId) && request.resource.data.balance == 0;
      allow update: if isAdmin();
      allow delete: if false;

      match /walletTransactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() ||
          (isOwner(userId) &&
            request.resource.data.type in ['deposit', 'withdraw'] &&
            request.resource.data.status == 'pending');
        allow update, delete: if isAdmin();
      }
    }

    // ---- Config Collections (قراءة عامة، كتابة للإدارة فقط) ----
    match /governorates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carTypes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Chats ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.passengerId == request.auth.uid ||
         request.resource.data.driverId == request.auth.uid);
      // تحديث lastMessage/typingUsers مسموح للمشاركين في المحادثة بس
      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.passengerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid ||
           isAdmin());
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn(); // تعليم كمقروءة من الطرف التاني
        allow delete: if isAdmin();
      }
    }

    // ---- Ratings ----
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAdmin(); // للإبلاغ عن تقييم مسيء لاحقًا
      allow delete: if isAdmin();
    }

    // ---- Reports (بلاغات) ----
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
  }
}
