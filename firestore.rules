rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isActiveAccount() {
      // توافق آمن مع الحسابات القديمة التي أُنشئت قبل إضافة حقل status.
      // الحساب الموقوف أو المحظور عنده قيمة صريحة، لذلك يظل ممنوعًا.
      return isSignedIn() && userDoc().data.get('status', 'active') == 'active';
    }

    function userGender() {
      return userDoc().data.gender;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isApprovedDriver() {
      return isActiveAccount() &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.verificationStatus == 'approved';
    }

    function linkedBooking(bookingId) {
      return getAfter(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function bookingDoc(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function offerDoc(offerId) {
      return get(/databases/$(database)/documents/tripOffers/$(offerId));
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function validUserNotification(targetUserId) {
      return request.resource.data.userId == targetUserId &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.isRead == false &&
        request.resource.data.type is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 500 &&
        request.resource.data.keys().hasOnly([
          'userId', 'actorId', 'type', 'title', 'body', 'relatedId', 'sourceId', 'isRead', 'createdAt'
        ]) &&
        (
          (
            request.resource.data.type == 'new_booking' &&
            request.resource.data.relatedId is string &&
            tripDoc(request.resource.data.relatedId).data.driverId == targetUserId &&
            request.auth.uid in tripDoc(request.resource.data.relatedId).data.get('participantIds', [])
          ) ||
          (
            request.resource.data.type in ['booking_accepted', 'booking_rejected'] &&
            request.resource.data.relatedId is string &&
            bookingDoc(request.resource.data.relatedId).data.passengerId == targetUserId &&
            bookingDoc(request.resource.data.relatedId).data.driverId == request.auth.uid
          ) ||
          (
            request.resource.data.type == 'chat_message' &&
            request.resource.data.relatedId is string &&
            (
              (
                chatDoc(request.resource.data.relatedId).data.passengerId == request.auth.uid &&
                chatDoc(request.resource.data.relatedId).data.driverId == targetUserId
              ) ||
              (
                chatDoc(request.resource.data.relatedId).data.driverId == request.auth.uid &&
                chatDoc(request.resource.data.relatedId).data.passengerId == targetUserId
              )
            )
          ) ||
          (
            request.resource.data.type == 'tripOffer' &&
            request.resource.data.sourceId is string &&
            offerDoc(request.resource.data.sourceId).data.driverId == request.auth.uid &&
            offerDoc(request.resource.data.sourceId).data.passengerId == targetUserId &&
            offerDoc(request.resource.data.sourceId).data.requestId == request.resource.data.relatedId
          ) ||
          (
            request.resource.data.type in ['tripOfferAccepted', 'tripOfferResponse'] &&
            request.resource.data.sourceId is string &&
            offerDoc(request.resource.data.sourceId).data.passengerId == request.auth.uid &&
            offerDoc(request.resource.data.sourceId).data.driverId == targetUserId
          ) ||
          (
            request.resource.data.type == 'trip_status' &&
            request.resource.data.relatedId is string &&
            tripDoc(request.resource.data.relatedId).data.driverId == request.auth.uid
          )
        );
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['passenger', 'driver'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.isPhoneVerified == false &&
        request.resource.data.isEmailVerified == false &&
        request.resource.data.trustScore == 0 &&
        request.resource.data.totalTrips == 0 &&
        request.resource.data.avgRating == 0;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        changedKeys().hasOnly([
          'fullName', 'gender', 'profileImageUrl', 'language', 'favoriteTrips'
        ])
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow update: if isAdmin() || (
          isOwner(userId) &&
          changedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead is bool
        );
        allow create: if isAdmin() || (isActiveAccount() && validUserNotification(userId));
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin()) &&
        request.resource.data.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'profileImageUrl', 'role', 'trustScore', 'totalTrips', 'avgRating'
        ]);
      allow delete: if isAdmin();
    }

    // ---- Drivers ----
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if isOwner(driverId) &&
        isActiveAccount() &&
        request.resource.data.verificationStatus == 'pending';
      allow update: if isAdmin() || (
        isOwner(driverId) &&
        resource.data.verificationStatus != 'approved' &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        changedKeys().hasOnly([
          'nationalIdImageUrl', 'nationalIdBackImageUrl', 'licenseImageUrl', 'licenseBackImageUrl', 'vehicleLicenseImageUrl',
          'vehicleImageUrl', 'selfieVerificationUrl', 'vehicle'
        ])
      );
      allow delete: if isAdmin();
    }

    // ---- Trips ----
    match /trips/{tripId} {
      allow read: if resource.data.isWomenOnly == false ||
        (isSignedIn() && (userGender() == 'female' || isAdmin()));

      allow create: if isApprovedDriver() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.totalSeats is int &&
        request.resource.data.availableSeats == request.resource.data.totalSeats &&
        request.resource.data.totalSeats > 0 &&
        request.resource.data.totalSeats <= 50 &&
        request.resource.data.pricePerSeat is number &&
        request.resource.data.pricePerSeat >= 0;

      allow update: if isAdmin() ||
        (
          isApprovedDriver() &&
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          changedKeys().hasOnly([
            'status', 'driverLiveLat', 'driverLiveLng', 'driverLiveUpdatedAt'
          ]) &&
          (request.resource.data.driverLiveLat == null ||
            (request.resource.data.driverLiveLat is number &&
             request.resource.data.driverLiveLng is number &&
             request.resource.data.driverLiveLat >= -90 && request.resource.data.driverLiveLat <= 90 &&
             request.resource.data.driverLiveLng >= -180 && request.resource.data.driverLiveLng <= 180))
        ) ||
        (
          isActiveAccount() &&
          changedKeys().hasOnly(['availableSeats', 'status', 'lastBookingId', 'participantIds']) &&
          request.resource.data.lastBookingId is string &&
          linkedBooking(request.resource.data.lastBookingId).data.tripId == tripId &&
          (
            (
              linkedBooking(request.resource.data.lastBookingId).data.passengerId == request.auth.uid &&
              linkedBooking(request.resource.data.lastBookingId).data.status == 'pending' &&
              request.resource.data.availableSeats ==
                resource.data.availableSeats - linkedBooking(request.resource.data.lastBookingId).data.seatsBooked
            ) ||
            (
              linkedBooking(request.resource.data.lastBookingId).data.passengerId == request.auth.uid &&
              linkedBooking(request.resource.data.lastBookingId).data.status == 'cancelled' &&
              request.resource.data.availableSeats ==
                resource.data.availableSeats + linkedBooking(request.resource.data.lastBookingId).data.seatsBooked
            ) ||
            (
              linkedBooking(request.resource.data.lastBookingId).data.driverId == request.auth.uid &&
              linkedBooking(request.resource.data.lastBookingId).data.status == 'rejected' &&
              request.resource.data.availableSeats ==
                resource.data.availableSeats + linkedBooking(request.resource.data.lastBookingId).data.seatsBooked
            )
          ) &&
          request.resource.data.availableSeats >= 0 &&
          request.resource.data.availableSeats <= resource.data.totalSeats &&
          (
            linkedBooking(request.resource.data.lastBookingId).data.status != 'pending' ||
            (
              request.auth.uid in request.resource.data.participantIds &&
              request.resource.data.participantIds.size() <= resource.data.get('participantIds', []).size() + 1
            )
          )
        );

      allow delete: if isAdmin() ||
        (isApprovedDriver() && resource.data.driverId == request.auth.uid);

      match /locationHistory/{pointId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('participantIds', []) ||
          isAdmin()
        );
        allow create: if isApprovedDriver() &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- Bookings (phase 1: cash only) ----
    match /bookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());

      allow create: if isActiveAccount() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.driverId ==
          get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.driverId &&
        request.resource.data.paymentMethod == 'cash' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.seatsBooked is int &&
        request.resource.data.seatsBooked > 0 &&
        request.resource.data.seatsBooked <= 8 &&
        request.resource.data.originalPrice ==
          get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.pricePerSeat *
          request.resource.data.seatsBooked &&
        request.resource.data.totalPrice == request.resource.data.originalPrice;

      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.passengerId == request.auth.uid &&
          (
            (
              resource.data.status in ['pending', 'confirmed'] &&
              request.resource.data.status == 'cancelled' &&
              changedKeys().hasOnly(['status'])
            ) ||
            (
              resource.data.status == 'confirmed' &&
              request.resource.data.status == resource.data.status &&
              changedKeys().hasOnly(['passengerLiveLat', 'passengerLiveLng', 'passengerLiveUpdatedAt']) &&
              (request.resource.data.passengerLiveLat == null ||
                (request.resource.data.passengerLiveLat is number &&
                 request.resource.data.passengerLiveLng is number &&
                 request.resource.data.passengerLiveLat >= -90 && request.resource.data.passengerLiveLat <= 90 &&
                 request.resource.data.passengerLiveLng >= -180 && request.resource.data.passengerLiveLng <= 180))
            )
          )
        ) ||
        (
          isApprovedDriver() &&
          resource.data.driverId == request.auth.uid &&
          (
            (
              resource.data.status == 'pending' &&
              request.resource.data.status in ['confirmed', 'rejected'] &&
              changedKeys().hasOnly(['status'])
            ) ||
            (
              resource.data.status == 'confirmed' &&
              request.resource.data.status == 'confirmed' &&
              (
                (
                  changedKeys().hasOnly(['pinVerified', 'pinAttempt']) &&
                  request.resource.data.pinVerified == true &&
                  request.resource.data.pinAttempt ==
                    get(/databases/$(database)/documents/bookingSecrets/$(bookingId)).data.pin
                ) ||
                (
                  resource.data.startPin is string &&
                  changedKeys().hasOnly(['pinVerified']) &&
                  request.resource.data.pinVerified == true
                )
              )
            ) ||
            (
              resource.data.status == 'confirmed' &&
              request.resource.data.status == 'completed' &&
              changedKeys().hasOnly([
                'status', 'passengerLiveLat', 'passengerLiveLng', 'passengerLiveUpdatedAt'
              ]) &&
              request.resource.data.passengerLiveLat == null &&
              request.resource.data.passengerLiveLng == null &&
              request.resource.data.passengerLiveUpdatedAt == null
            )
          )
        );
      allow delete: if isAdmin();
    }

    match /bookingSecrets/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.bookingId == bookingId &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.pin is string &&
        request.resource.data.pin.size() == 4 &&
        getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.passengerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Wallets (server/admin controlled during phase 1) ----
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.balance is number &&
        request.resource.data.balance == 0;
      allow update: if isAdmin();
      allow delete: if false;

      match /walletTransactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          request.resource.data.type in ['deposit', 'withdraw'] &&
          request.resource.data.status == 'pending' &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.amount <= 50000 &&
          !request.resource.data.keys().hasAny(['balanceAfter']) &&
          request.resource.data.keys().hasOnly([
            'type', 'amount', 'status', 'method', 'senderNumber', 'transactionReference', 'accountNumber', 'createdAt'
          ]) &&
          (
            (
              request.resource.data.type == 'deposit' &&
              request.resource.data.method in ['فودافون كاش', 'أورنج كاش', 'اتصالات كاش'] &&
              request.resource.data.senderNumber is string &&
              request.resource.data.senderNumber.size() >= 10 &&
              request.resource.data.senderNumber.size() <= 20 &&
              request.resource.data.transactionReference is string &&
              request.resource.data.transactionReference.size() >= 3 &&
              request.resource.data.transactionReference.size() <= 100
            ) ||
            (
              request.resource.data.type == 'withdraw' &&
              request.resource.data.method is string &&
              request.resource.data.accountNumber is string &&
              request.resource.data.accountNumber.size() >= 8 &&
              request.resource.data.accountNumber.size() <= 100
            )
          );
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---- Config Collections ----
    match /governorates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carTypes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Chats ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin());
      allow create: if (
        isActiveAccount() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.driverId != request.auth.uid &&
        (
          (
            request.resource.data.relatedBookingId is string &&
            bookingDoc(request.resource.data.relatedBookingId).data.passengerId == request.resource.data.passengerId &&
            bookingDoc(request.resource.data.relatedBookingId).data.driverId == request.resource.data.driverId &&
            bookingDoc(request.resource.data.relatedBookingId).data.status in ['confirmed', 'completed']
          ) ||
          (
            request.resource.data.relatedOfferId is string &&
            offerDoc(request.resource.data.relatedOfferId).data.passengerId == request.resource.data.passengerId &&
            offerDoc(request.resource.data.relatedOfferId).data.driverId == request.resource.data.driverId &&
            offerDoc(request.resource.data.relatedOfferId).data.status == 'accepted'
          )
        )
      ) || (
        isApprovedDriver() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.passengerId != request.auth.uid &&
        (
          (
            request.resource.data.relatedBookingId is string &&
            bookingDoc(request.resource.data.relatedBookingId).data.passengerId == request.resource.data.passengerId &&
            bookingDoc(request.resource.data.relatedBookingId).data.driverId == request.resource.data.driverId &&
            bookingDoc(request.resource.data.relatedBookingId).data.status in ['confirmed', 'completed']
          ) ||
          (
            request.resource.data.relatedOfferId is string &&
            offerDoc(request.resource.data.relatedOfferId).data.passengerId == request.resource.data.passengerId &&
            offerDoc(request.resource.data.relatedOfferId).data.driverId == request.resource.data.driverId &&
            offerDoc(request.resource.data.relatedOfferId).data.status == 'accepted'
          )
        )
      );
      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid) &&
        changedKeys().hasOnly(['lastMessage', 'lastMessageAt']);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.passengerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid ||
           isAdmin());
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.passengerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /tripRequests/{requestId} {
      allow read: if true;
      allow create: if (isActiveAccount() || isAdmin()) &&
        request.resource.data.passengerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.passengerId == request.auth.uid);
    }

    match /tripOffers/{offerId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);
      allow create: if isApprovedDriver() &&
        request.resource.data.driverId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.passengerId == request.auth.uid &&
        changedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    match /tripAlerts/{alertId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        ratingId == request.resource.data.bookingId + '_' + request.auth.uid &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'tripId', 'bookingId', 'fromUserId', 'toUserId', 'direction', 'stars', 'comment', 'isReported', 'createdAt'
        ]) &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5 &&
        bookingDoc(request.resource.data.bookingId).data.status == 'completed' &&
        bookingDoc(request.resource.data.bookingId).data.tripId == request.resource.data.tripId &&
        (
          (
            request.resource.data.direction == 'passengerToDriver' &&
            bookingDoc(request.resource.data.bookingId).data.passengerId == request.auth.uid &&
            bookingDoc(request.resource.data.bookingId).data.driverId == request.resource.data.toUserId
          ) ||
          (
            request.resource.data.direction == 'driverToPassenger' &&
            bookingDoc(request.resource.data.bookingId).data.driverId == request.auth.uid &&
            bookingDoc(request.resource.data.bookingId).data.passengerId == request.resource.data.toUserId
          )
        );
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
